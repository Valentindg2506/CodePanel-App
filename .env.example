# CodePanel · configuración de ejemplo
# Copia este archivo como .env (o .env.php, que el servidor no sirve como texto) y rellena los valores.
# Las variables de entorno del servidor tienen prioridad sobre este archivo.

# Base de datos MySQL 8 / MariaDB 10.5+. Instalación nueva: database/schema.sql. Actualización: database/migrations/.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=codepanel
DB_USER=codepanel
DB_PASS=
DB_CHARSET=utf8mb4

# Entorno y dirección pública. Con APP_ENV=production, scripts/verify.sh exige APP_DEBUG,
# DEMO_FALLBACK y ALLOW_REGISTRATION en false.
APP_ENV=production
APP_URL=https://codepanel.example.com

# Zona horaria por defecto para cuentas nuevas (identificador IANA).
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Muestra detalles de errores y la versión de PHP en /health. Nunca en producción.
APP_DEBUG=false

# Alta pública de cuentas. Cerrada por defecto: con la base vacía se permite crear la primera cuenta.
ALLOW_REGISTRATION=false

# Espacio de muestra con datos de ejemplo cuando no hay base de datos. Sólo para enseñar la app:
# en producción debe quedar en false para que una base caída dé error y no abra la demo.
DEMO_FALLBACK=false

# Sesión. SESSION_SECURE=auto marca la cookie como segura cuando la petición llega por HTTPS.
SESSION_NAME=codepanel_session
SESSION_SECURE=auto

# Archivos adjuntos (en bytes). Los máximos del código son 10 MiB por archivo y 100 MiB por cuenta.
UPLOAD_MAX_BYTES=10485760
UPLOAD_USER_QUOTA_BYTES=104857600
